Options -Indexes
DirectoryIndex portal.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^vendor(?:/|$) - [F,L,NC]
RewriteRule ^(?:index|pop)\.html$ - [F,L,NC]
</IfModule>
<FilesMatch "^\.(?:ht|env)|^(?:\.geb-systems-auth\.php|\.systems-pass\.php)$">
Require all denied
</FilesMatch>
<FilesMatch "^\.rotinas-(?:gestao|vapid|subs|sent)\.json$">
Require all denied
</FilesMatch>

<FilesMatch "\.webmanifest$">
ForceType application/manifest+json
</FilesMatch>
